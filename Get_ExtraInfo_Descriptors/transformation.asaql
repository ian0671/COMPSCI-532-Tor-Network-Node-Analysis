    b.source, b.type, b.timestamp, b.EventProcessedUtcTime, b.PartitionId, b.EventEnqueuedUtcTime,
    b.payload.nickname, b.payload.fingerprint,
    TRY_CAST(b.payload.published AS datetime) AS published,
    b.payload.signature, b.payload.geoip_db_digest, b.payload.geoip6_db_digest,
    b.payload.read_history_end, b.payload.read_history_interval,
    b.payload.write_history_end, b.payload.write_history_interval,
    b.payload.dir_stats_end, b.payload.dir_stats_interval,
