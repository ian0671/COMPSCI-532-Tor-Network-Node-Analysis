    TRY_CAST([e4fe39a5-9dad-2d20-9be7-86b4fc565811-input].[PartitionId] AS bigint) AS [PartitionId],
    TRY_CAST([e4fe39a5-9dad-2d20-9be7-86b4fc565811-input].[EventEnqueuedUtcTime] AS datetime) AS [EventEnqueuedUtcTime]
FROM [e4fe39a5-9dad-2d20-9be7-86b4fc565811-input]
TIMESTAMP BY EventEnqueuedUtcTime
),

[78993475-fdb5-ab23-104e-944eb912ef1f] AS (
