WITH

[e4fe39a5-9dad-2d20-9be7-86b4fc565811] AS (
SELECT
    TRY_CAST([e4fe39a5-9dad-2d20-9be7-86b4fc565811-input].[payload] AS record) AS [payload],
    TRY_CAST([e4fe39a5-9dad-2d20-9be7-86b4fc565811-input].[source] AS nvarchar(max)) AS [source],
    TRY_CAST([e4fe39a5-9dad-2d20-9be7-86b4fc565811-input].[type] AS nvarchar(max)) AS [type],
