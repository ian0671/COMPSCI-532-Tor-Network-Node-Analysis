WITH

[0d481e28-edf4-8c78-d23d-67ce4afce371] AS (
SELECT
    TRY_CAST([0d481e28-edf4-8c78-d23d-67ce4afce371-input].[payload] AS record) AS [payload],
    TRY_CAST([0d481e28-edf4-8c78-d23d-67ce4afce371-input].[source] AS nvarchar(max)) AS [source],
    TRY_CAST([0d481e28-edf4-8c78-d23d-67ce4afce371-input].[type] AS nvarchar(max)) AS [type],
    TRY_CAST([0d481e28-edf4-8c78-d23d-67ce4afce371-input].[timestamp] AS nvarchar(max)) AS [timestamp],
    TRY_CAST([0d481e28-edf4-8c78-d23d-67ce4afce371-input].[EventProcessedUtcTime] AS datetime) AS [EventProcessedUtcTime],
    TRY_CAST([0d481e28-edf4-8c78-d23d-67ce4afce371-input].[PartitionId] AS bigint) AS [PartitionId],
    TRY_CAST([0d481e28-edf4-8c78-d23d-67ce4afce371-input].[EventEnqueuedUtcTime] AS datetime) AS [EventEnqueuedUtcTime]
FROM [0d481e28-edf4-8c78-d23d-67ce4afce371-input]
TIMESTAMP BY EventEnqueuedUtcTime
),

[1e56b0a1-43dc-d80d-dab7-7a3936a732ca] AS (
SELECT
    [0d481e28-edf4-8c78-d23d-67ce4afce371].[payload],
    [0d481e28-edf4-8c78-d23d-67ce4afce371].[source],
    [0d481e28-edf4-8c78-d23d-67ce4afce371].[type],
    [0d481e28-edf4-8c78-d23d-67ce4afce371].[timestamp],
    [0d481e28-edf4-8c78-d23d-67ce4afce371].[EventProcessedUtcTime],
    [0d481e28-edf4-8c78-d23d-67ce4afce371].[PartitionId],
    [0d481e28-edf4-8c78-d23d-67ce4afce371].[EventEnqueuedUtcTime]
FROM [0d481e28-edf4-8c78-d23d-67ce4afce371]
WHERE ([0d481e28-edf4-8c78-d23d-67ce4afce371].[source] = 'Get_Microdescriptors')
),

[937703e3-6f51-77b1-f131-b9725b27f1b9] AS (
SELECT
    [1e56b0a1-43dc-d80d-dab7-7a3936a732ca].[source] AS [source],
    [1e56b0a1-43dc-d80d-dab7-7a3936a732ca].[type] AS [type],
    [1e56b0a1-43dc-d80d-dab7-7a3936a732ca].[timestamp] AS [timestamp],
    [1e56b0a1-43dc-d80d-dab7-7a3936a732ca].[EventProcessedUtcTime] AS [EventProcessedUtcTime],
    [1e56b0a1-43dc-d80d-dab7-7a3936a732ca].[PartitionId] AS [PartitionId],
    [1e56b0a1-43dc-d80d-dab7-7a3936a732ca].[EventEnqueuedUtcTime] AS [EventEnqueuedUtcTime],
    CAST([1e56b0a1-43dc-d80d-dab7-7a3936a732ca].[payload].[onion_key] AS nvarchar(max)) AS [onion_key],
    CAST([1e56b0a1-43dc-d80d-dab7-7a3936a732ca].[payload].[ntor_onion_key] AS nvarchar(max)) AS [ntor_onion_key],
    CAST([1e56b0a1-43dc-d80d-dab7-7a3936a732ca].[payload].[exit_policy] AS nvarchar(max)) AS [exit_policy],
    CAST([1e56b0a1-43dc-d80d-dab7-7a3936a732ca].[payload].[identifier] AS nvarchar(max)) AS [identifier],
    CAST([1e56b0a1-43dc-d80d-dab7-7a3936a732ca].[payload].[identifier_type] AS nvarchar(max)) AS [identifier_type]
FROM [1e56b0a1-43dc-d80d-dab7-7a3936a732ca]
)

SELECT
    [937703e3-6f51-77b1-f131-b9725b27f1b9].[source],
    [937703e3-6f51-77b1-f131-b9725b27f1b9].[type],
    [937703e3-6f51-77b1-f131-b9725b27f1b9].[timestamp],
    [937703e3-6f51-77b1-f131-b9725b27f1b9].[EventProcessedUtcTime],
    [937703e3-6f51-77b1-f131-b9725b27f1b9].[PartitionId],
    [937703e3-6f51-77b1-f131-b9725b27f1b9].[EventEnqueuedUtcTime],
    [937703e3-6f51-77b1-f131-b9725b27f1b9].[onion_key],
    [937703e3-6f51-77b1-f131-b9725b27f1b9].[ntor_onion_key],
    [937703e3-6f51-77b1-f131-b9725b27f1b9].[exit_policy],
    [937703e3-6f51-77b1-f131-b9725b27f1b9].[identifier],
    [937703e3-6f51-77b1-f131-b9725b27f1b9].[identifier_type]
INTO [9fc3c8b2-e709-74f7-6c5f-8902e1e513f5]
FROM [937703e3-6f51-77b1-f131-b9725b27f1b9]

