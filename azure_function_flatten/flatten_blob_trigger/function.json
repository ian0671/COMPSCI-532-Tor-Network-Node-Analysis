{
  "scriptFile": "__init__.py",
  "bindings": [
    {
      "name": "blob",
      "type": "blobTrigger",
      "direction": "in",
      "path": "abuseipdb/{path}.parquet",
      "connection": "AzureWebJobsStorage"
    },
    {
      "type": "blob",
      "direction": "out",
      "name": "$return",
      "path": "flattened/{name}",
      "connection": "AzureWebJobsStorage"
    }
  ]
}
